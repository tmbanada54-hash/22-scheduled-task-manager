# SQLite file; mount persistent storage here in hosted environments.
DATABASE_PATH=data/tasks.sqlite3
SCHEDULER_ENABLED=true
POLL_INTERVAL_SECONDS=1
MAX_CONCURRENCY=5
LEASE_GRACE_SECONDS=30

# Optional, but strongly recommended whenever the API is reachable by others.
# Clients must send this value in the X-API-Key header when configured.
API_KEY=

# Comma-separated, exact hostnames/IP addresses. Empty allows any public target.
ALLOWED_TARGET_HOSTS=
# Only enable for trusted networks or local demos; this permits access to internal services.
ALLOW_PRIVATE_TARGETS=false

# Comma-separated frontend origins, e.g. https://dashboard.example.com
CORS_ORIGINS=
